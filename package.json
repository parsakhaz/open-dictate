{
  "name": "dictate",
  "version": "0.2.5",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "description": "Local dictation for Windows, macOS and Linux: hold a shortcut, speak, and insert cleaned text into the focused app.",
  "license": "AGPL-3.0-or-later",
  "main": "out/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint src test",
    "test:scripts": "node --test scripts/*.test.mjs qa/prepare-native.test.mjs",
    "package": "node build.mjs && electron-builder --publish never",
    "package:dir": "node build.mjs && electron-builder --dir --publish never",
    "smoke:package": "node scripts/smoke-package.mjs",
    "release:check": "node scripts/release.mjs validate",
    "release:checksums": "node scripts/release.mjs checksums",
    "postinstall": "node qa/prepare-native.mjs --report tmp/package-smoke/native-install.json"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "koffi": "3.3.3",
    "sherpa-onnx-node": "1.13.8",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "electron": "44.9.2",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "node-gyp": "12.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "author": "parsakhaz",
  "repository": {
    "type": "git",
    "url": "https://github.com/parsakhaz/open-dictate.git"
  },
  "desktopName": "org.dictate.Dictate.desktop"
}
